# FILE: .env.example
# MỤC ĐÍCH: Mẫu cấu hình có thể đưa vào Git; .env thật phải được giữ riêng.
# CÁCH DÙNG / VIỆC CẦN LÀM:
# 1. Copy sang .env nếu chưa có; không ghi đè cấu hình thật đang dùng.
# 2. Thay mọi mật khẩu ví dụ, sinh JWT_SECRET ngẫu nhiên; không đăng secret lên Git.
# 3. ELECTION_ID phải ổn định cho cuộc bầu cử; mốc thời gian ISO 8601 có múi giờ.
# 4. Không đặt private key cử tri hoặc KMS vào env. Tên biến phải khớp config và compose.
# ĐỌC KÈM: docs/STRUCTURE.md

JWT_SECRET=change_me_please_use_secrets_token_hex_32

# --- PostgreSQL passwords ---
POSTGRES_ROOT_PASSWORD=root123
APP_USER_PASSWORD=app123
ADMIN_USER_PASSWORD=admin123
TALLY_USER_PASSWORD=tally123

# --- Backend local (dùng sau khi đã viết code) ---
# Các password trong URL phải khớp role phía trên; ký tự đặc biệt cần URL-encode.
# Nếu dựng URL trong Python, dùng sqlalchemy.engine.URL.create để xử lý password.
DATABASE_URL=postgresql://app_user:app123@127.0.0.1:5432/evoting
ADMIN_DATABASE_URL=postgresql://admin_app:admin123@127.0.0.1:5432/evoting
TALLY_DATABASE_URL=postgresql://tally_user:tally123@127.0.0.1:5432/evoting

# --- Admin login (hard-code theo yêu cầu đề bài) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- KMS ---
KMS_KEY_DIR=./kms_keys

# --- Election time window (ISO 8601 UTC) ---
ELECTION_ID=student-council-2026
# Vote chỉ được chấp nhận trong khoảng này.
# Tally chỉ chạy khi now >= ELECTION_END.
ELECTION_START=2026-01-01T00:00:00Z
ELECTION_END=2026-12-31T23:59:59Z
