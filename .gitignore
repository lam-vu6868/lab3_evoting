# FILE: .gitignore
# MỤC ĐÍCH: Chặn secret, môi trường cài đặt và file sinh tự động khỏi Git.
# CÁCH DÙNG: Git tự đọc; git check-ignore kiểm tra đường dẫn bị bỏ qua.
# Giữ docs/, tests/, *.md trong Git. File đã tracked không tự bị untrack.
.env
.env.*
!.env.example
kms_keys/
pgdata/
*.pem
*.key
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/
*.swp
~$*.docx
.DS_Store
Thumbs.db
